# RSQ Authority Dashboard — Environment Variables
# Copy this file to .env.local and fill in the real values from the Firebase Console.
# NEVER commit .env.local to version control.

# Firebase Web SDK Configuration
# Find these values in: Firebase Console → Project Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# ─── Firestore Configuration ────────────────────────────────────────────────
# VERIFIED: The RSQ Firestore database stores disaster reports in "reports".
# Change this only if the collection name differs in your deployment.
VITE_REPORTS_COLLECTION=reports

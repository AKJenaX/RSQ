rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -- HELPER FUNCTIONS ---------------------------------------------------------
    
    function isAuthority() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'AUTHORITY' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.authorized == true;
    }
    
    function validReportUpdate() {
      // Allow authority to update only specific incident management fields
      let allowedKeys = ['assignedVolunteerId', 'assignedResourceIds', 'assignedAt', 'assignedBy', 'status', 'resolvedAt', 'resolvedBy', 'resolutionNote'];
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      
      let isValidAssignedBy = (!affectedKeys.hasAny(['assignedBy'])) || (request.resource.data.assignedBy == request.auth.uid);
      let isValidResolvedBy = (!affectedKeys.hasAny(['resolvedBy'])) || (request.resource.data.resolvedBy == request.auth.uid);

      return affectedKeys.hasOnly(allowedKeys) && isValidAssignedBy && isValidResolvedBy;
    }
    
    function validStatus() {
      let nextStatus = request.resource.data.get('status', resource.data.status);
      let prevStatus = resource.data.status;
      
      return (nextStatus == prevStatus) ||
             (prevStatus == 'OPEN' && (nextStatus == 'ASSIGNED' || nextStatus == 'IN_PROGRESS' || nextStatus == 'ESCALATED' || nextStatus == 'RESOLVED')) ||
             (prevStatus == 'ASSIGNED' && (nextStatus == 'IN_PROGRESS' || nextStatus == 'OPEN' || nextStatus == 'RESOLVED' || nextStatus == 'ESCALATED')) ||
             (prevStatus == 'IN_PROGRESS' && (nextStatus == 'RESOLVED' || nextStatus == 'ESCALATED' || nextStatus == 'OPEN' || nextStatus == 'ASSIGNED')) ||
             (prevStatus == 'ESCALATED' && (nextStatus == 'ASSIGNED' || nextStatus == 'IN_PROGRESS' || nextStatus == 'RESOLVED' || nextStatus == 'OPEN')) ||
             (prevStatus == 'RESOLVED' && nextStatus == 'OPEN');
    }

    function isOwnerSyncUpdate() {
      let diff = request.resource.data.diff(resource.data);
      let affected = diff.affectedKeys();

      let isOwner = request.auth != null &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid;

      let onlyImagesChanged =
          affected.hasOnly(['imageUrl', 'imageUrls']);

      let noAuthorityFields =
          !affected.hasAny([
            'assignedVolunteerId',
            'assignedResourceIds',
            'assignedAt',
            'assignedBy',
            'resolvedAt',
            'resolvedBy',
            'resolutionNote'
          ]);

      return isOwner && onlyImagesChanged && noAuthorityFields;
    }

    // -- SECURITY POLICIES --------------------------------------------------------

    // 1. Users collection: Users can read their own role document to check auth.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Role provisioning happens via Admin SDK/Console only
    }

    // 2. Reports collection:
    match /reports/{reportId} {
      // Android App / Victims can create reports as long as they are authenticated
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Authority users can read all reports
      // (Optionally: allow normal users to read their own reports)
      allow read: if isAuthority() || (request.auth != null && resource.data.userId == request.auth.uid);
      
      // Changed: Allow either Authority updates OR Owner sync updates
      allow update: if isOwnerSyncUpdate() || (isAuthority() && validReportUpdate() && validStatus());
      
      // No one can delete reports from the client
      allow delete: if false;
      
      // 3. Report Activity Subcollection
      match /activity/{activityId} {
        allow read: if isAuthority();
        // Activity log is append-only by authorities
        allow create: if isAuthority();
        allow update, delete: if false;
      }
    }
    
    // 3.b Collection Group query for Activity
    match /{path=**}/activity/{activityId} {
      allow read: if isAuthority();
    }
    
    // 4. Volunteers collection
    match /volunteers/{volunteerId} {
      allow read, create, update, delete: if isAuthority();
    }
    
    // 5. Resources collection
    match /resources/{resourceId} {
      allow read, create, update, delete: if isAuthority();
    }

    // 6. Global Activity Collection (for non-report specific activity, e.g. financial)
    match /activity/{activityId} {
      allow read, create, update, delete: if isAuthority();
    }

    // 7. Financial Management
    match /donations/{donationId} {
      allow read, create, update, delete: if isAuthority();
    }
    
    match /funds/{fundId} {
      allow read, create, update, delete: if isAuthority();
    }
    
    match /allocations/{allocationId} {
      allow read, create, update, delete: if isAuthority();
    }
    
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAuthority();
    }
    
    match /financialReports/{reportId} {
      allow read, create: if isAuthority();
      allow update, delete: if false;
    }
  }
}
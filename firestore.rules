rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── HELPER FUNCTIONS ─────────────────────────────────────────────────────────
    
    function isAuthority() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth != null &&
             user.data.role == 'AUTHORITY' &&
             user.data.authorized == true;
    }
    
    function validReportUpdate() {
      // Allow authority to update only specific incident management fields
      let allowedKeys = ['assignedVolunteerId', 'assignedResourceIds', 'assignedAt', 'assignedBy', 'status', 'resolvedAt', 'resolvedBy', 'resolutionNote'];
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(allowedKeys);
    }
    
    function validStatus() {
      let nextStatus = request.resource.data.get('status', resource.data.status);
      return nextStatus in ['OPEN', 'ASSIGNED', 'IN_PROGRESS', 'RESOLVED'];
    }

    // ── SECURITY POLICIES ────────────────────────────────────────────────────────

    // 1. Users collection: Users can read their own role document to check auth.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Role provisioning happens via Admin SDK/Console only
    }

    // 2. Reports collection:
    match /reports/{reportId} {
      // Android App / Victims can create reports as long as they are authenticated
      allow create: if request.auth != null;
      
      // Authority users can read all reports
      // (Optionally: allow normal users to read their own reports)
      allow read: if isAuthority() || (request.auth != null && resource.data.userId == request.auth.uid);
      
      // Authority users can update specific fields to manage incidents
      allow update: if isAuthority() && validReportUpdate() && validStatus();
      
      // No one can delete reports from the client
      allow delete: if false;
      
      // 3. Report Activity Subcollection
      match /activity/{activityId} {
        allow read: if isAuthority();
        // Activity log is append-only by authorities
        allow create: if isAuthority();
        allow update, delete: if false;
      }
    }
    
    // 4. Volunteers collection
    match /volunteers/{volunteerId} {
      allow read: if isAuthority();
      allow update: if isAuthority();
      allow create, delete: if false;
    }
    
    // 5. Resources collection
    match /resources/{resourceId} {
      allow read: if isAuthority();
      allow update: if isAuthority();
      allow create, delete: if false;
    }
  }
}
